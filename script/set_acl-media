#!/bin/bash

# Script Name: set_acl-media.sh
# Author: Skyler Ogden
# Date: 2026-09-13
# Version: 1.3
# Description: This script sets default ACLs for the specified directories
#              for the user and group 'media' with read and write permissions.
# 1.2
# Moved from setfacl to setgid to be more universally compatible as we only
# ever use a single group
# 1.3
# Optimized to process all directories at once and traverse file trees only once.

# Check if at least one directory argument is provided
if [ "$#" -lt 1 ]; then
    echo "Usage: $0 /path/to/directory1 /path/to/directory2 ..."
    exit 1
fi

VALID_DIRS=()

# Filter and collect all valid directory arguments
for DIRECTORY in "$@"; do
    if [ ! -d "$DIRECTORY" ]; then
        echo "Error: $DIRECTORY is not a valid directory."
    else
        VALID_DIRS+=("$DIRECTORY")
    fi
done

if [ ${#VALID_DIRS[@]} -eq 0 ]; then
    echo "Error: No valid directories to process."
    exit 1
fi

# Set ownership of all valid directories recursively in one command
sudo chown media:media -R "${VALID_DIRS[@]}"

# Use a single find traversal for both directories and files
# This cuts disk I/O in half for large directories
sudo find "${VALID_DIRS[@]}" \
    \( -type d -exec chmod 2775 {} + \) -o \
    \( -type f -exec chmod 664 {} + \)

for DIRECTORY in "${VALID_DIRS[@]}"; do
    echo "Permissions successfully set for $DIRECTORY"
    ls -ld "$DIRECTORY"
done
